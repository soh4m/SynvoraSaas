@model Synvora.Models.ContactViewModel

@{
    ViewData["Title"] = "Contact Sales | Synvora";
}

<div class="position-relative overflow-hidden w-100">
    <!-- Design System BG Gradients -->
    <div class="gradient-bg-light"></div>
    <div class="glow-ellipse-light" style="top: 0px; background: radial-gradient(circle, rgba(37, 99, 235, 0.05) 0%, transparent 60%);"></div>

    <div class="container py-5 text-start">
        <!-- Contact Header -->
        <section class="py-5 mb-5 text-center" data-aos="fade-up">
            <span class="text-uppercase text-muted fw-bold font-monospace fs-7 tracking-wider">Connect With Us</span>
            <h1 class="display-3 text-dark fw-bold mt-2 mb-3">Talk to Sales</h1>
            <p class="text-secondary mx-auto fs-5" style="max-width: 600px;">
                Specify your project requirements below. Our enterprise engineering team will follow up within 12 business hours.
            </p>
        </section>

        <section class="my-5">
            <div class="row g-5">
                <!-- Contact Form Column -->
                <div class="col-lg-7" data-aos="fade-right">
                    <!-- Success banner if form is posted successfully -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert bg-success bg-opacity-10 border border-success border-opacity-30 text-success p-4 rounded-4 mb-4" role="alert">
                            <div class="d-flex gap-3 align-items-start">
                                <i class="bi bi-check-circle-fill fs-4"></i>
                                <div>
                                    <h5 class="alert-heading fw-bold mb-1">Request Received</h5>
                                    <p class="mb-0 fs-6 text-success-emphasis">@TempData["SuccessMessage"]</p>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="enterprise-form-light">
                        <form asp-controller="Home" asp-action="Contact" method="post" novalidate>
                            @Html.AntiForgeryToken()
                            
                            <!-- Validation Summary -->
                            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                            {
                                <div class="alert bg-danger bg-opacity-10 border border-danger border-opacity-30 text-danger p-3 rounded-3 mb-4" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Please correct the highlighted errors below.
                                </div>
                            }

                            <!-- Name Field -->
                            <div class="form-group-custom">
                                <label asp-for="Name" class="form-label-custom"></label>
                                <input asp-for="Name" class="form-input-light" placeholder="e.g. John Doe" />
                                <span asp-validation-for="Name" class="form-validation-error"></span>
                            </div>

                            <!-- Email Field -->
                            <div class="form-group-custom">
                                <label asp-for="Email" class="form-label-custom"></label>
                                <input asp-for="Email" type="email" class="form-input-light" placeholder="e.g. john.doe@utkarsh.com" />
                                <span asp-validation-for="Email" class="form-validation-error"></span>
                            </div>

                            <!-- Subject Field -->
                            <div class="form-group-custom">
                                <label asp-for="Subject" class="form-label-custom"></label>
                                <input asp-for="Subject" class="form-input-light" placeholder="e.g. API Integration Architecture Demo" />
                                <span asp-validation-for="Subject" class="form-validation-error"></span>
                            </div>

                            <!-- Product Interest dropdown -->
                            <div class="form-group-custom">
                                <label asp-for="ProductInterest" class="form-label-custom"></label>
                                <select asp-for="ProductInterest" class="form-input-light" style="appearance: none; background-image: url('data:image/svg+xml;utf8,<svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;16&quot; height=&quot;16&quot; fill=&quot;%2371717a&quot; class=&quot;bi bi-chevron-down&quot; viewBox=&quot;0 0 16 16&quot;><path fill-rule=&quot;evenodd&quot; d=&quot;M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z&quot;/></svg>'); background-repeat: no-repeat; background-position: right 18px center; padding-right: 40px;">
                                    <option value="" disabled selected>Select a product line...</option>
                                    <option value="Synvora Compute Workloads">Synvora Compute (Serverless Sandboxing)</option>
                                    <option value="Synvora Flow Pipelines">Synvora Flow (Logic Orchestration)</option>
                                    <option value="Synvora Ledger Database">Synvora Ledger (Immutable Ledger Accounting)</option>
                                    <option value="Utkarsh Enterprise Partner Program">Utkarsh Enterprises Partnership</option>
                                </select>
                                <span asp-validation-for="ProductInterest" class="form-validation-error"></span>
                            </div>

                            <!-- Message Field -->
                            <div class="form-group-custom">
                                <label asp-for="Message" class="form-label-custom"></label>
                                <textarea asp-for="Message" rows="5" class="form-input-light" placeholder="Briefly describe your requirements or workloads..."></textarea>
                                <span asp-validation-for="Message" class="form-validation-error"></span>
                            </div>

                            <button type="submit" class="btn-primary-custom w-100 justify-content-center">
                                Send Message <i class="bi bi-chevron-right ms-1"></i>
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Info sidebar -->
                <div class="col-lg-5" data-aos="fade-left">
                    <div class="info-card-light h-100 d-flex flex-column justify-content-between">
                        <div>
                            <span class="text-uppercase text-muted fw-bold font-monospace fs-7 tracking-wider">Enterprise HQ</span>
                            <h4 class="text-white fw-bold mt-2 mb-4">Contact Information</h4>
                            
                            <div class="mb-4">
                                <div class="text-muted font-monospace fs-7 mb-1">Corporate HQ Address</div>
                                <div class="text-white fs-6">
                                    Utkarsh Enterprises Headquarters,<br/>
                                    Nariman Point,<br/>
                                    Mumbai, MH 400021, India
                                </div>
                            </div>
                            
                            <div class="mb-4">
                                <div class="text-muted font-monospace fs-7 mb-1">Email Coordinates</div>
                                <div class="text-white fs-6">
                                    General Inquiries: <a href="mailto:info@synvora.com">info@synvora.com</a><br/>
                                    Developer API Support: <a href="mailto:support@synvora.com">support@synvora.com</a>
                                </div>
                            </div>
                            
                            <div class="mb-4">
                                <div class="text-muted font-monospace fs-7 mb-1">Telephone Hotlines</div>
                                <div class="text-white fs-6">
                                    International: +91 (22) 555-UTKARSH<br/>
                                    Toll-Free Support: 1800-UTKARSH-SYN
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 pt-4 border-top border-secondary border-opacity-20 text-muted fs-7">
                            <span class="text-muted font-monospace">Governance compliance:</span> Synvora products division strictly adheres to global GDPR constraints and is fully ISO 27001 compliant under parent auditing policies.
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <!-- Client-side Validation Scripts -->
    <partial name="_ValidationScriptsPartial" />
}
