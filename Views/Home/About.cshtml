@{
    ViewData["Title"] = "Enterprise Core | Synvora";
}

<div class="position-relative overflow-hidden w-100">
    <!-- Design System BG Gradients -->
    <div class="gradient-bg-light"></div>
    <div class="glow-ellipse-light" style="top:-100px; background: radial-gradient(circle, rgba(37, 99, 235, 0.05) 0%, transparent 60%);"></div>

    <div class="container py-5 text-start">
        <!-- About Hero -->
        <section class="py-5 mb-5 text-center" data-aos="fade-up">
            <span class="text-uppercase text-muted fw-bold font-monospace fs-7 tracking-wider">Enterprise Division</span>
            <h1 class="display-3 text-dark fw-bold mt-2 mb-3">Corporate Overview</h1>
            <p class="text-secondary mx-auto fs-5" style="max-width: 650px;">
                Synvora is a modern enterprise software products company powered by Utkarsh Enterprises, establishing next-generation cloud infrastructure standard models.
            </p>
        </section>

        <!-- Parent backing detail (Utkarsh Enterprises) -->
        <section class="py-5 my-5">
            <div class="row align-items-center gy-5">
                <div class="col-lg-6" data-aos="fade-right">
                    <span class="text-uppercase text-primary fw-bold font-monospace fs-7">Corporate Synergy</span>
                    <h2 class="text-dark fw-bold mt-2 mb-4">Powered by Utkarsh Enterprises</h2>
                    <p class="text-secondary mb-3">
                        As a software division of Utkarsh Enterprises, Synvora leverages a global network of financial compliance frameworks, high-speed regional cloud data centers, and rigorous enterprise security layers.
                    </p>
                    <p class="text-secondary">
                        Our division benefits from parent-level R&D capitalization, enabling us to guarantee 99.999% uptime and zero ledger reconciliation discrepancies for financial systems. With Utkarsh Enterprises backing, we serve clients ranging from scaling startup innovators to Fortune 500 corporations.
                    </p>
                </div>
                <div class="col-lg-6 text-center" data-aos="fade-left">
                    <div class="premium-card-light d-inline-block p-5" style="max-width: 420px; border-color: rgba(37, 99, 235, 0.15);">
                        <!-- SVG Logo Wrapper -->
                        <div class="mx-auto mb-4" style="width: 120px; height: 120px;">
                            <img src="~/img/logo-utkarsh.svg" alt="Utkarsh Enterprises Logo" class="img-fluid" />
                        </div>
                        <h5 class="text-dark fw-bold mb-2">Utkarsh Enterprises</h5>
                        <p class="text-muted fs-7 mb-0">
                            Global Infrastructure Parent Corporation. Safeguarding security, backing compliance models, and powering Synvora engineering assets.
                        </p>
                    </div>
                </div>
            </div>
        </section>


        <!-- Vision and values -->
        <section class="py-5 my-5" data-aos="fade-up">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="premium-card-light h-100">
                        <h4 class="text-dark mb-3">Modular Safety</h4>
                        <p class="text-secondary fs-6 mb-0">
                            We believe that software should be modular. By isolating Compute, Flow, and Ledger layers, companies can eliminate single-point system vulnerabilities and build highly testable applications.
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="premium-card-light h-100">
                        <h4 class="text-dark mb-3">Developer-Centric</h4>
                        <p class="text-secondary fs-6 mb-0">
                            Great software is built for developers. We design clear REST endpoints, performant client SDK interfaces, and command-line management consoles that simplify system deployments.
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="premium-card-light h-100">
                        <h4 class="text-dark mb-3">Rigorous Trust</h4>
                        <p class="text-secondary fs-6 mb-0">
                            Our financial transaction systems are cryptographically sealed. With double-entry integrity constraints embedded natively in the ledger core, balance discrepancies are mathematically impossible.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Corporate Timeline (Mercury style metrics grid) -->
        <section class="py-5 my-5">
            <div class="text-center mb-5" data-aos="fade-up">
                <span class="text-uppercase text-muted fw-bold font-monospace fs-7 tracking-wider">Historical Context</span>
                <h3 class="text-dark fw-bold mt-2">Division History Timeline</h3>
            </div>

            <div class="row justify-content-center" data-aos="zoom-in">
                <div class="col-lg-10">
                    <div class="dashboard-mockup-light">
                        <div class="mockup-header-light">
                            <span class="mockup-dot red"></span>
                            <span class="mockup-dot yellow"></span>
                            <span class="mockup-dot green"></span>
                            <span class="mockup-title-light">synvora-division-timeline</span>
                        </div>
                        <div class="mockup-body-light p-4 text-start">
                            <div class="row gy-4 font-monospace">
                                <div class="col-md-3 border-end border-secondary border-opacity-20 pe-lg-4">
                                    <div class="text-primary fw-bold fs-5">2021</div>
                                    <div class="text-white mt-1">Research Incubation</div>
                                    <p class="text-muted fs-7 mt-2">
                                        Founded as an infrastructure division within Utkarsh Labs to investigate high-scale distributed data logs.
                                    </p>
                                </div>
                                <div class="col-md-3 border-end border-secondary border-opacity-20 px-lg-4">
                                    <div class="text-primary fw-bold fs-5">2023</div>
                                    <div class="text-white mt-1">Ledger Core Launch</div>
                                    <p class="text-muted fs-7 mt-2">
                                        Released the first production-grade cryptographically verified ledger database to Utkarsh internal assets.
                                    </p>
                                </div>
                                <div class="col-md-3 border-end border-secondary border-opacity-20 px-lg-4">
                                    <div class="text-primary fw-bold fs-5">2025</div>
                                    <div class="text-white mt-1">SaaS Portal Launch</div>
                                    <p class="text-muted fs-7 mt-2">
                                        Aggregated Compute sandboxing and Flow logic engines into a unified managed cloud SaaS system.
                                    </p>
                                </div>
                                <div class="col-md-3 ps-lg-4">
                                    <div class="text-primary fw-bold fs-5">2026</div>
                                    <div class="text-success mt-1">Synvora v2.0 Rollout</div>
                                    <p class="text-muted fs-7 mt-2">
                                        Platform handles over 4.2 Billion compute hours globally with full compliance credentials.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="py-5 my-4 text-center rounded-4" style="background: var(--bg-secondary); border: 1px solid var(--border-color);" data-aos="zoom-in">
            <h3 class="text-dark fw-bold">Interested in partnering with Synvora?</h3>
            <p class="text-secondary mx-auto mb-4" style="max-width: 500px;">
                Learn more about our enterprise licensing models, white-label services, and parent integrations.
            </p>
            <a asp-controller="Home" asp-action="Contact" class="btn-secondary-custom text-decoration-none">
                Submit Corporate Request
            </a>
        </section>
    </div>
</div>
