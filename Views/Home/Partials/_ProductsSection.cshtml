@* Reusable Enterprise Software Products section *@
<section class="py-5 my-5" data-aos="fade-up">
    <div class="text-center mb-4">
        <span class="text-uppercase text-muted fw-bold font-monospace fs-7 tracking-wider">Enterprise Software Products</span>
        <h3 class="text-dark fw-bold mt-2">Products for Regulated Industries & Retail</h3>
        <p class="text-secondary mx-auto" style="max-width: 700px;">
            Purpose-built enterprise software for pharma, jewellery, retail POS, and bespoke custom solutions — designed for compliance, traceability, and operational velocity.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="0">
            <div class="premium-card-light h-100">
                <div class="card-icon-wrapper-light card-icon-indigo-light mb-3">
                    <i class="bi bi-capsule fs-4"></i>
                </div>
                <h5 class="text-dark fw-bold">Pharma ERP</h5>
                <p class="text-secondary fs-7 mb-3">A compliant ERP stack tailored for pharmaceutical distributors and manufacturers.</p>
                <ul class="text-secondary fs-7 mb-4" style="padding-left: 1rem;">
                    <li>Inventory Management</li>
                    <li>Billing</li>
                    <li>Purchase</li>
                    <li>Sales</li>
                    <li>Expiry Tracking</li>
                    <li>GST</li>
                </ul>
                <div class="d-flex gap-2">
                    <a asp-controller="Home" asp-action="Products" class="btn-secondary-custom text-decoration-none">Learn More</a>
                    <a asp-controller="Home" asp-action="Contact" class="btn-primary-custom text-decoration-none">Book Demo</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="100">
            <div class="premium-card-light h-100">
                <div class="card-icon-wrapper-light card-icon-accent-light mb-3">
                    <i class="bi bi-gem fs-4"></i>
                </div>
                <h5 class="text-dark fw-bold">Jewellery ERP</h5>
                <p class="text-secondary fs-7 mb-3">Inventory and valuation workflows built for jewellers and supply networks.</p>
                <ul class="text-secondary fs-7 mb-4" style="padding-left: 1rem;">
                    <li>Inventory</li>
                    <li>Gold Valuation</li>
                    <li>Barcode</li>
                    <li>Karigar Management</li>
                    <li>Billing</li>
                    <li>Repair Management</li>
                </ul>
                <div class="d-flex gap-2">
                    <a asp-controller="Home" asp-action="Products" class="btn-secondary-custom text-decoration-none">Learn More</a>
                    <a asp-controller="Home" asp-action="Contact" class="btn-primary-custom text-decoration-none">Book Demo</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="200">
            <div class="premium-card-light h-100">
                <div class="card-icon-wrapper-light card-icon-indigo-light mb-3">
                    <i class="bi bi-cart-plus fs-4"></i>
                </div>
                <h5 class="text-dark fw-bold">POS Software</h5>
                <p class="text-secondary fs-7 mb-3">Modern point-of-sale with fast billing and inventory sync for retail.</p>
                <ul class="text-secondary fs-7 mb-4" style="padding-left: 1rem;">
                    <li>Retail Billing</li>
                    <li>Barcode</li>
                    <li>Inventory</li>
                    <li>Customer Management</li>
                    <li>Reports</li>
                    <li>GST</li>
                </ul>
                <div class="d-flex gap-2">
                    <a asp-controller="Home" asp-action="Products" class="btn-secondary-custom text-decoration-none">Learn More</a>
                    <a asp-controller="Home" asp-action="Contact" class="btn-primary-custom text-decoration-none">Book Demo</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="300">
            <div class="premium-card-light h-100">
                <div class="card-icon-wrapper-light card-icon-accent-light mb-3">
                    <i class="bi bi-cloud-arrow-up fs-4"></i>
                </div>
                <h5 class="text-dark fw-bold">Custom Software</h5>
                <p class="text-secondary fs-7 mb-3">Bespoke desktop, web, and cloud solutions tailored to your workflows.</p>
                <ul class="text-secondary fs-7 mb-4" style="padding-left: 1rem;">
                    <li>Desktop Applications</li>
                    <li>Web Applications</li>
                    <li>Cloud Solutions</li>
                    <li>Automation</li>
                    <li>API Integration</li>
                </ul>
                <div class="d-flex gap-2">
                    <a asp-controller="Home" asp-action="Products" class="btn-secondary-custom text-decoration-none">Learn More</a>
                    <a asp-controller="Home" asp-action="Contact" class="btn-primary-custom text-decoration-none">Book Demo</a>
                </div>
            </div>
        </div>
    </div>
</section>
